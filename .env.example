# Скопируйте в .env и заполните. Файл .env в репозиторий не добавляется.

# Django
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Полный адрес с портом, если он не 443: https://nir.example.org:8443
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# PostgreSQL (используются и сервисом db, и приложением)
POSTGRES_DB=stocktaking
POSTGRES_USER=stocktaking
POSTGRES_PASSWORD=замените-пароль-бд

# Первый администратор: создаётся при первом запуске, если такого пользователя нет. Можно не задавать.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=замените-пароль-администратора

# nginx и HTTPS. Каталог с server.crt и server.key; если файлов нет, создаётся самоподписанный сертификат.
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker/certs

# Ограничения импорта
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_FILES=200
IMPORT_MAX_BATCH_MB=200
# Пакет больше этого числа файлов обрабатывается в фоне
IMPORT_SYNC_LIMIT=20
# Отчёт «Качество данных»: работа считается давно не обновлявшейся через столько дней
STALE_WORK_DAYS=90

# Выгрузка в JSON: без файлов и не больше стольких записей — сразу, иначе — в фоне (worker)
EXPORT_SYNC_ROWS=5000

# Блокировка входа
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15

# Почта: уведомления ответственным об ожидающих загрузках (0 — выключено)
NOTIFY_PENDING_HOURS=0
SITE_URL=https://localhost
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=stocktaking@localhost

# LDAP / Active Directory (выключено). Режим 1: шаблон DN. Режим 2: поиск служебной учётной записью.
LDAP_ENABLED=0
LDAP_SERVER_URI=ldap://ldap.example.org
LDAP_START_TLS=0
LDAP_USER_DN_TEMPLATE=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=ou=people,dc=example,dc=org
LDAP_SEARCH_FILTER=(uid={username})
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_ATTR_EMAIL=mail
